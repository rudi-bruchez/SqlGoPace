# .env.example — copier en .env et renseigner. NE PAS versionner le .env réel.
# Le .env est chargé au démarrage et substitué dans config.yaml via ${VARIABLE}.

# --- Connexion SQL Server ---
DB_SERVER=localhost
DB_NAME=EXAMPLEDB

# Auth SQL (laisser vide si auth Windows / Azure AD)
DB_USER=
DB_PASSWORD=

# --- Notifications (optionnel) ---
# URL de webhook (Slack/Teams/générique). Laisser vide pour désactiver.
WEBHOOK_URL=
