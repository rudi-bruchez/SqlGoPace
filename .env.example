# .env.example — copy to .env and fill in. Do NOT version the real .env.
# The .env is loaded at startup and substituted into config.yaml via ${VARIABLE}.

# --- SQL Server connection ---
DB_SERVER=localhost
DB_NAME=MYDB

# SQL auth (leave empty for Windows / Azure AD auth)
DB_USER=
DB_PASSWORD=

# --- Notifications (optional) ---
# Webhook URL (Slack/Teams/generic). Leave empty to disable.
WEBHOOK_URL=
